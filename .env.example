# FRIDAY — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. FRIDAY runs
# perfectly with an empty file — the bridge authenticates off your Claude Code
# login, and voice input and output both fall back to the browser's own speech.
# Copy this to .env.local, and add only what you actually want to change.
#
# The one line worth adding is ELEVENLABS_API_KEY, down in the BRIDGE section:
# it gives you a much better voice and Scribe transcription. The free tier is
# plenty for a demo. Never commit a real key.
#
# Two audiences read these variables:
#   - the BRIDGE (the Node server, bridge/server.mjs) reads the FRIDAY_* and
#     ELEVENLABS_API_KEY variables from its shell environment.
#   - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
# Only VITE_-prefixed values ever reach the browser.


# ===================================================================
# BRIDGE (the server) — read from the shell that runs `npm run bridge`
# ===================================================================
# These are shown with their defaults. Leave them unset to accept the default.

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# FRIDAY_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run. Default claude-sonnet-5-5.
# Use claude-opus-5-5 for harder work; it replies more slowly.
# FRIDAY_MODEL=claude-sonnet-5-5

# Reasoning effort. Default low, which keeps replies quick.
# FRIDAY_EFFORT=low

# Allow effectful tools (send, tap, delete, install, pay). Off by default, so
# FRIDAY can look at anything and change nothing. `npm run bridge:writes` sets
# this to 1 for you — read the decideTool gate in bridge/server.mjs first.
# FRIDAY_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed; add others only if you serve the app
# from a different address. Default: none.
# FRIDAY_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# FRIDAY_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included; this is
# for anything outside them, such as an external drive of footage. Default: none.
# FRIDAY_FILE_ROOTS=

# Local speech model. base.en is faster, medium.en more accurate. Default small.en.
# Any other name must exist as mlx-community/whisper-<name>-mlx on Apple Silicon.
# FRIDAY_WHISPER_MODEL=small.en

# ElevenLabs voice id for the bridge's own speech endpoint. Default: Alice.
# FRIDAY_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# ElevenLabs API key. Optional. With it, FRIDAY speaks in the ElevenLabs voice
# and transcribes with ElevenLabs Scribe; without it, everything still works on
# the browser's own speech. If you already have an elevenlabs MCP server in
# ~/.claude.json, the bridge reads the key from there and you can leave this
# blank. Default: none.
# ELEVENLABS_API_KEY=


# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge — talk to the local bridge (recommended). No API key, and every MCP
#            server in your Claude Code config is available.
#   direct — the browser calls the Claude API itself. Needs VITE_ANTHROPIC_API_KEY.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep the port in step with FRIDAY_BRIDGE_PORT above.
# Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine, used when no ElevenLabs voice is active.
# Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Accent for Chrome's recogniser, the fallback when local Whisper is missing.
# Default en-IN.
# VITE_SPEECH_LANG=en-IN

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bf_emma.
# VITE_KOKORO_VOICE=bf_emma

# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false

# Anthropic API key — DIRECT MODE ONLY. Required if and only if
# VITE_BACKEND=direct, and it ships to the browser, so use it only for a local
# demo. The default bridge mode never reads it. Default: none.
# VITE_ANTHROPIC_API_KEY=


# ===================================================================
# HANDS (hands/config/api_keys.json — not an env var)
# ===================================================================
# Optional. A FREE Gemini key from https://aistudio.google.com/apikey unlocks
# the smart step in some hands tools (web grounding, YouTube summaries, reading
# documents and images, finding things on screen). Put it in
# hands/config/api_keys.json as:  {"gemini_api_key": "YOUR_KEY"}
# That file is gitignored. Never commit a real key.
